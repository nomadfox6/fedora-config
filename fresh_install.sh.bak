#!/usr/bin/env bash
set -euo pipefail

# ── COPR ─────────────────────────────────────
dnf5 copr enable solopasha/hyprland -y

# ── Packages ─────────────────────────────────
dnf5 install -y \
    `# Hyprland & Wayland core` \
    hyprland \
    qt5-qtwayland \
    qt6-qtwayland \
    `# XDG portals` \
    xdg-desktop-portal \
    xdg-desktop-portal-hyprland \
    `# Keyring` \
    gnome-keyring \
    `# Display manager` \
    sddm \
    `# Printing` \
    cups \
    system-config-printer \
    `# Terminal` \
    foot \
    `# Launcher` \
    wofi \
    `# Notifications` \
    dunst \
    libnotify \
    `# Audio` \
    pipewire \
    pipewire-pulseaudio \
    wireplumber \
    `# Screenshots` \
    grim \
    slurp \
    `# Clipboard` \
    wl-clipboard \
    `# Polkit agent` \
    hyprpolkitagent \
    `# Screen lock` \
    hyprlock \
    hypridle \
    `# Network` \
    network-manager-applet \
    wireguard-tools \
    `# Browser` \
    firefox \
    `# File manager` \
    nautilus \
    gvfs \
    gvfs-mtp \
    file-roller \
    `# Bluetooth` \
    blueman \
    `# Sync` \
    seafile-client \
    syncthing \
    `# User directories` \
    xdg-user-dirs \
    `# Fonts` \
    jetbrains-mono-fonts \
    fontawesome-6-free-fonts \
    fontawesome-6-brands-fonts \
    google-noto-color-emoji-fonts \
    `# GTK theme & icons` \
    papirus-icon-theme \
    adwaita-cursor-theme \
    `# Wallpaper` \
    swww \
    waypaper \
    python3-imageio \
    python3-screeninfo \
    python3-platformdirs \
    `# Python (Monique and pip tools)` \
    python3 \
    python3-pip \
    python3-gobject \
    gtk4 \
    libadwaita \
    `# cursor-clip build dependencies` \
    rust \
    cargo \
    libadwaita-devel \
    `# AGS build dependencies` \
    meson ninja-build vala valadoc golang npm \
    gjs gjs-devel \
    gobject-introspection-devel \
    gtk4-devel gtk4-layer-shell-devel \
    glib2-devel json-glib-devel \
    wayland-protocols-devel \
    appmenu-glib-translator appmenu-glib-translator-devel \
    `# Flatpak` \
    flatpak

# ── Astal ─────────────────────────────────────
USER_HOME="$(getent passwd "$SUDO_USER" | cut -d: -f6)"

echo "==> Cloning and building Astal..."
git clone https://github.com/aylur/astal.git "$USER_HOME/astal"

cd "$USER_HOME/astal/lib/astal/io"
meson setup build && meson install -C build

cd "$USER_HOME/astal/lib/astal/gtk4"
meson setup build && meson install -C build

cd "$USER_HOME/astal/lib/tray"
meson setup build && meson install -C build

cd "$USER_HOME/astal/lib/hyprland"
meson setup build && meson install -C build

# ── AGS ───────────────────────────────────────
echo "==> Cloning and building AGS..."
git clone https://github.com/aylur/ags.git "$USER_HOME/ags"

cd "$USER_HOME/ags"
sudo -u "$SUDO_USER" npm install
meson setup build && meson install -C build

# ── Flatpak ───────────────────────────────────
echo "==> Adding Flathub remote..."
sudo -u "$SUDO_USER" flatpak remote-add --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo

echo "==> Installing Flatpak apps..."
sudo -u "$SUDO_USER" flatpak install -y flathub be.alexandervanhee.gradia

# ── cursor-clip (clipboard manager) ──────────
echo "==> Building cursor-clip..."
sudo -u "$SUDO_USER" git clone https://github.com/Sirulex/cursor-clip "$USER_HOME/cursor-clip"
sudo -u "$SUDO_USER" bash -c "cd '$USER_HOME/cursor-clip' && cargo build --release"
sudo -u "$SUDO_USER" mkdir -p "$USER_HOME/.local/bin"
sudo -u "$SUDO_USER" cp "$USER_HOME/cursor-clip/target/release/cursor-clip" "$USER_HOME/.local/bin/"

# ── Remove unwanted COPR packages ────────────
echo "==> Removing unwanted packages..."
dnf5 remove -y nwg-panel 2>/dev/null || true
rm -rf "$USER_HOME/.config/nwg-panel"

# ── GTK theme (Nordic) ───────────────────────
echo "==> Installing Nordic GTK theme..."
sudo -u "$SUDO_USER" mkdir -p "$USER_HOME/.local/share/themes"
curl -sL "https://github.com/EliverLara/Nordic/releases/latest/download/Nordic.tar.xz" \
    -o /tmp/Nordic.tar.xz
tar -xf /tmp/Nordic.tar.xz -C "$USER_HOME/.local/share/themes/"
chown -R "$SUDO_USER:$SUDO_USER" "$USER_HOME/.local/share/themes/Nordic"

# ── foot (terminal) ──────────────────────────
echo "==> Configuring foot terminal..."
sudo -u "$SUDO_USER" mkdir -p "$USER_HOME/.config/foot"

cat > "$USER_HOME/.config/foot/foot.ini" <<'EOF'
[main]
font=JetBrains Mono:size=12
pad=8x8

[cursor]
style=block
blink=no

[scrollback]
lines=10000

[colors]
foreground=d8dee9
background=2e3440
selection-foreground=000000
selection-background=fffacd

regular0=3b4252
regular1=bf616a
regular2=a3be8c
regular3=ebcb8b
regular4=81a1c1
regular5=b48ead
regular6=88c0d0
regular7=e5e9f0

bright0=4c566a
bright1=bf616a
bright2=a3be8c
bright3=ebcb8b
bright4=81a1c1
bright5=b48ead
bright6=8fbcbb
bright7=eceff4
EOF

# ── GTK settings ─────────────────────────────
echo "==> Applying GTK settings..."
sudo -u "$SUDO_USER" mkdir -p "$USER_HOME/.config/gtk-3.0" "$USER_HOME/.config/gtk-4.0"

cat > "$USER_HOME/.config/gtk-3.0/settings.ini" <<'EOF'
[Settings]
gtk-theme-name=Nordic
gtk-icon-theme-name=Papirus-Dark
gtk-font-name=JetBrains Mono 11
gtk-cursor-theme-name=Adwaita
gtk-cursor-theme-size=24
gtk-application-prefer-dark-theme=1
gtk-button-images=0
gtk-menu-images=0
gtk-enable-event-sounds=0
gtk-enable-input-feedback-sounds=0
EOF

cat > "$USER_HOME/.config/gtk-4.0/settings.ini" <<'EOF'
[Settings]
gtk-theme-name=Nordic
gtk-icon-theme-name=Papirus-Dark
gtk-font-name=JetBrains Mono 11
gtk-cursor-theme-name=Adwaita
gtk-cursor-theme-size=24
gtk-application-prefer-dark-theme=1
EOF

sudo -u "$SUDO_USER" gsettings set org.gnome.desktop.interface gtk-theme 'Nordic'
sudo -u "$SUDO_USER" gsettings set org.gnome.desktop.interface icon-theme 'Papirus-Dark'
sudo -u "$SUDO_USER" gsettings set org.gnome.desktop.interface cursor-theme 'Adwaita'
sudo -u "$SUDO_USER" gsettings set org.gnome.desktop.interface font-name 'JetBrains Mono 11'
sudo -u "$SUDO_USER" gsettings set org.gnome.desktop.interface document-font-name 'JetBrains Mono 11'
sudo -u "$SUDO_USER" gsettings set org.gnome.desktop.interface monospace-font-name 'JetBrains Mono 11'
sudo -u "$SUDO_USER" gsettings set org.gnome.desktop.interface color-scheme 'prefer-dark'

# ── Monique (display configurator) ───────────
echo "==> Installing Monique..."
sudo -u "$SUDO_USER" pip3 install --user monique

# ── SDDM Nordic theme ────────────────────────
echo "==> Installing SDDM Nordic theme..."
mkdir -p /usr/share/sddm/themes/nordic

cat > /usr/share/sddm/themes/nordic/metadata.desktop <<'EOF'
[SddmGreeterTheme]
Name=Nordic
Description=Minimal Nord-themed SDDM greeter
Author=custom
Version=1.0
License=MIT
Type=sddm-theme
EOF

cat > /usr/share/sddm/themes/nordic/Main.qml <<'QMLEOF'
import QtQuick 2.15
import QtQuick.Controls 2.15
import QtQuick.Layouts 1.15
import SddmComponents 2.0

Rectangle {
    id: root
    width: Screen.width
    height: Screen.height
    color: "#2E3440"

    Repeater {
        model: screenModel
        Background {
            x: geometry.x
            y: geometry.y
            width: geometry.width
            height: geometry.height
            source: config.background
            fillMode: Image.PreserveAspectCrop
        }
    }

    Rectangle {
        anchors.fill: parent
        color: "#2E3440"
        opacity: config.background !== "" ? 0.55 : 1.0
    }

    Rectangle {
        id: card
        anchors.centerIn: parent
        width: 380
        height: col.implicitHeight + 64
        color: "#2E3440"
        opacity: 0.96
        radius: 12
        border.color: "#88C0D0"
        border.width: 2

        ColumnLayout {
            id: col
            anchors {
                top: parent.top
                left: parent.left
                right: parent.right
                topMargin: 32
                leftMargin: 32
                rightMargin: 32
            }
            spacing: 0

            Text {
                Layout.fillWidth: true
                text: sddm.hostName
                font.family: "JetBrains Mono"
                font.pixelSize: 28
                font.weight: Font.Bold
                color: "#ECEFF4"
                horizontalAlignment: Text.AlignHCenter
                Layout.bottomMargin: 6
            }

            Text {
                Layout.fillWidth: true
                text: Qt.formatDateTime(new Date(), "dddd, MMMM d")
                font.family: "JetBrains Mono"
                font.pixelSize: 13
                color: "#81A1C1"
                horizontalAlignment: Text.AlignHCenter
                Layout.bottomMargin: 28
                Timer {
                    interval: 60000; running: true; repeat: true
                    onTriggered: parent.text = Qt.formatDateTime(new Date(), "dddd, MMMM d")
                }
            }

            ComboBox {
                id: sessionCombo
                Layout.fillWidth: true
                Layout.bottomMargin: 12
                visible: sessionModel.rowCount() > 1
                model: sessionModel
                textRole: "name"
                currentIndex: sessionModel.lastIndex
                background: Rectangle {
                    color: "transparent"
                    border.color: "#4C566A"
                    border.width: 2
                    radius: 8
                }
                contentItem: Text {
                    leftPadding: 12
                    text: sessionCombo.displayText
                    font.family: "JetBrains Mono"
                    font.pixelSize: 13
                    color: "#D8DEE9"
                    verticalAlignment: Text.AlignVCenter
                }
            }

            TextField {
                id: userField
                Layout.fillWidth: true
                Layout.bottomMargin: 10
                placeholderText: "Username"
                text: userModel.lastUser
                font.family: "JetBrains Mono"
                font.pixelSize: 14
                color: "#D8DEE9"
                placeholderTextColor: "#4C566A"
                leftPadding: 14
                rightPadding: 14
                background: Rectangle {
                    color: "#3B4252"
                    border.color: userField.activeFocus ? "#88C0D0" : "#4C566A"
                    border.width: 2
                    radius: 8
                }
                Keys.onTabPressed: passField.forceActiveFocus()
                Keys.onReturnPressed: passField.forceActiveFocus()
                KeyNavigation.tab: passField
            }

            TextField {
                id: passField
                Layout.fillWidth: true
                Layout.bottomMargin: 20
                placeholderText: "Password"
                echoMode: TextInput.Password
                font.family: "JetBrains Mono"
                font.pixelSize: 14
                color: "#D8DEE9"
                placeholderTextColor: "#4C566A"
                leftPadding: 14
                rightPadding: 14
                background: Rectangle {
                    color: "#3B4252"
                    border.color: passField.activeFocus ? "#88C0D0" : "#4C566A"
                    border.width: 2
                    radius: 8
                }
                Keys.onReturnPressed: loginButton.doLogin()
                KeyNavigation.tab: loginButton
            }

            Text {
                id: errorMsg
                Layout.fillWidth: true
                Layout.bottomMargin: errorMsg.visible ? 12 : 0
                text: ""
                visible: text !== ""
                font.family: "JetBrains Mono"
                font.pixelSize: 12
                color: "#BF616A"
                horizontalAlignment: Text.AlignHCenter
                wrapMode: Text.WordWrap
            }

            Rectangle {
                id: loginButton
                Layout.fillWidth: true
                Layout.bottomMargin: 32
                height: 42
                radius: 8
                color: loginMouse.containsMouse ? "#3B4252" : "transparent"
                border.color: loginMouse.containsMouse ? "#88C0D0" : "#4C566A"
                border.width: 2
                Behavior on color { ColorAnimation { duration: 120 } }
                Behavior on border.color { ColorAnimation { duration: 120 } }
                Text {
                    anchors.centerIn: parent
                    text: "Login"
                    font.family: "JetBrains Mono"
                    font.pixelSize: 14
                    font.weight: Font.Bold
                    color: loginMouse.containsMouse ? "#ECEFF4" : "#D8DEE9"
                }
                MouseArea {
                    id: loginMouse
                    anchors.fill: parent
                    hoverEnabled: true
                    cursorShape: Qt.PointingHandCursor
                    onClicked: loginButton.doLogin()
                }
                Keys.onReturnPressed: doLogin()
                KeyNavigation.tab: userField
                activeFocusOnTab: true
                function doLogin() {
                    errorMsg.text = ""
                    sddm.login(userField.text, passField.text, sessionCombo.currentIndex)
                }
            }
        }
    }

    Row {
        anchors { bottom: parent.bottom; right: parent.right; margins: 24 }
        spacing: 12
        Repeater {
            model: [
                { label: "⏻", tip: "Shut down", action: function() { sddm.powerOff() } },
                { label: "↺", tip: "Restart",   action: function() { sddm.reboot()   } },
            ]
            delegate: Rectangle {
                width: 40; height: 40; radius: 20
                color: ma.containsMouse ? "#3B4252" : "transparent"
                border.color: ma.containsMouse ? "#88C0D0" : "#4C566A"
                border.width: 2
                Behavior on color { ColorAnimation { duration: 120 } }
                Behavior on border.color { ColorAnimation { duration: 120 } }
                Text {
                    anchors.centerIn: parent
                    text: modelData.label
                    font.pixelSize: 16
                    color: ma.containsMouse ? "#ECEFF4" : "#D8DEE9"
                }
                ToolTip.visible: ma.containsMouse
                ToolTip.text: modelData.tip
                MouseArea {
                    id: ma; anchors.fill: parent
                    hoverEnabled: true; cursorShape: Qt.PointingHandCursor
                    onClicked: modelData.action()
                }
            }
        }
    }

    Column {
        anchors { bottom: parent.bottom; left: parent.left; margins: 24 }
        spacing: 2
        Text {
            id: clockText
            text: Qt.formatDateTime(new Date(), "HH:mm")
            font.family: "JetBrains Mono"
            font.pixelSize: 32
            font.weight: Font.Bold
            color: "#ECEFF4"
            Timer {
                interval: 1000; running: true; repeat: true
                onTriggered: clockText.text = Qt.formatDateTime(new Date(), "HH:mm")
            }
        }
    }

    Connections {
        target: sddm
        function onLoginFailed() {
            errorMsg.text = "Incorrect username or password"
            passField.text = ""
            passField.forceActiveFocus()
        }
    }

    Component.onCompleted: {
        if (userField.text === "") userField.forceActiveFocus()
        else passField.forceActiveFocus()
    }
}
QMLEOF

mkdir -p /etc/sddm.conf.d
cat > /etc/sddm.conf.d/10-nordic.conf <<'EOF'
[Theme]
Current=nordic
CursorTheme=Adwaita
EOF

# ── Groups ───────────────────────────────────
usermod -aG video "$SUDO_USER"

# ── Services ─────────────────────────────────
systemctl set-default graphical.target
systemctl enable sddm
systemctl enable bluetooth
systemctl enable cups

# ── User directories ─────────────────────────
sudo -u "$SUDO_USER" xdg-user-dirs-update

echo ""
echo "Done. Reboot to start into SDDM / Hyprland."
